table FundingPlans
	lineageTag: ee396ce4-1062-4b35-8cdd-1e81c38f1435

	measure Requirements = SUM(FundingPlans[RequirementsUSD])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d4636370-5960-408d-9547-ccd1edfa9148

	measure Funding = SUM(FundingPlans[FundingUSD])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 6ae4dc7d-b009-4f3e-9d0e-cb64dc27f9c7

	measure 'Funding Gap' = SUM(FundingPlans[GapUSD])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c106d594-ff9f-4515-8673-0f4a74c02a7f

	measure Coverage = DIVIDE([Funding], [Requirements])
		formatString: 0.0%
		lineageTag: 7239a604-0973-431b-8e22-48cb2bdb0bb7

	measure 'Plans Tracked' = DISTINCTCOUNT(FundingPlans[PlanID])
		formatString: 0
		lineageTag: c6004cd4-8403-4c62-b7e8-eb639bf17740

	measure 'Median Coverage' = MEDIAN(FundingPlans[CoveragePct])
		formatString: 0.0%
		lineageTag: 0f6cff06-a112-427b-9996-96aa1b0280eb

	measure 'Priority Index' = SUM(FundingPlans[PriorityScore])
		formatString: #,0
		lineageTag: b5e0ce0a-b2e8-4779-8e69-c5d527cc832b

	column PlanID
